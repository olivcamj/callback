generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  clerkId        String          @unique
  email          String          @unique
  name           String?
  imageUrl       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  interviewPlans InterviewPlan[]
  sessions       Session[]
}

// Mirrors questionTypeSchema in src/lib/ai/schemas/interview-plan.ts.
enum QuestionType {
  behavioral
  technical
  role
}

model InterviewPlan {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], onDelete: Cascade, references: [id])
  // The job description as the user pasted it.
  jdText    String
  // The validated model output minus questions: role, level, mustHaveSkills,
  // niceToHave. Questions are stored as rows so answers can reference them.
  parsed    Json
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  questions Question[]
  sessions  Session[]

  @@index([userId, createdAt])
}

model Question {
  id         String        @id @default(cuid())
  planId     String
  plan       InterviewPlan @relation(fields: [planId], onDelete: Cascade, references: [id])
  // Zero-based position in the plan, in the order the model returned them.
  position   Int
  type       QuestionType
  prompt     String
  competency String
  whyAsked   String
  createdAt  DateTime      @default(now())
  answers    Answer[]

  @@unique([planId, position])
}

// One run through a plan's questions. userId duplicates plan.userId so
// ownership checks and per-user history don't need to join through the plan.
model Session {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], onDelete: Cascade, references: [id])
  planId    String
  plan      InterviewPlan @relation(fields: [planId], onDelete: Cascade, references: [id])
  startedAt DateTime      @default(now())
  // Null while the session is in progress.
  endedAt   DateTime?
  answers   Answer[]

  @@index([userId, startedAt])
  @@index([planId, startedAt])
}

model Answer {
  id          String   @id @default(cuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], onDelete: Cascade, references: [id])
  questionId  String
  question    Question @relation(fields: [questionId], onDelete: Cascade, references: [id])
  transcript  String
  durationSec Int
  // Validated model feedback. Null until the answer has been scored.
  scores      Json?
  createdAt   DateTime @default(now())

  @@unique([sessionId, questionId])
}
